<%- include('partials/header') %>
<div class="grid cols-2">
  <div class="card">
    <h2>Profile photo</h2>
    <p class="muted" style="margin-top:-4px">Upload an image for your profile.</p>
    <% if (msg) { %><div class="alert ok"><%- msg %></div><% } %>
    <form method="post" action="/upload" enctype="multipart/form-data">
      <label>Choose file</label>
      <input type="file" name="avatar">
      <div style="margin-top:16px"><button class="btn">Upload</button></div>
    </form>
  </div>
  <div class="card">
    <h2>Import from URL</h2>
    <p class="muted" style="margin-top:-4px">Fetch a profile photo from a web address.</p>
    <form method="get" action="/avatar/fetch" style="display:flex;gap:10px">
      <input name="url" placeholder="https://example.com/photo.jpg" style="flex:1">
      <button class="btn navy">Fetch</button>
    </form>
  </div>
</div>
<%- include('partials/footer') %>
