<%- include('partials/header') %>
<div class="card" style="background:linear-gradient(120deg,#0a2540,#164a86);color:#fff;border:0;padding:44px 40px">
  <div style="display:flex;flex-wrap:wrap;align-items:center;gap:30px;justify-content:space-between">
    <div style="max-width:520px">
      <div style="color:#c9a227;font-weight:700;letter-spacing:2px;font-size:12px">MERIDIAN TRUST · PRIVATE BANKING</div>
