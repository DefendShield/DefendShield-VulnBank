<%- include('partials/header') %>
<div style="max-width:420px;margin:20px auto">
  <div class="card">
    <h2 style="text-align:center">Choose a new password</h2>
    <form method="post" action="/reset/confirm">
      <label>Reset token</label>
      <input name="token" value="<%= token %>">
      <label>New password</label>
      <input name="password" type="password" placeholder="New password">
      <div style="margin-top:20px"><button class="btn block">Update password</button></div>
    </form>
  </div>
</div>
<%- include('partials/footer') %>
